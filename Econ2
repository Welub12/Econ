@import url('https://fonts.googleapis.com/css2?family=Cambria&family=Nunito:wght@400;600;700;800&display=swap');

:root { --teal:#12464f; --deep:#0b3138; --gold:#c99a2e; --clay:#a24e2c; --ink:#1e2b28; --soft:#52605b; --ice:#d8e6e4; --cream:#f4f0e4; }
* { box-sizing:border-box; }
body { margin:0; min-height:100vh; background:#ddd9ce; color:var(--ink); font-family:Nunito, Arial, sans-serif; display:grid; place-items:center; padding:20px 20px 76px; }
.deck { width:min(1100px, 100%); aspect-ratio:16 / 9; position:relative; box-shadow:0 16px 45px #0003; }
.slide { display:none; position:absolute; inset:0; padding:6.5% 6%; background:#fff; overflow:hidden; }
.slide.active { display:block; }
.title-slide, .dark-slide { background:var(--deep); color:#fff; }
.title-slide { padding-top:11%; }
h1,h2 { font-family:Georgia, 'Times New Roman', serif; }
h1 { font-size:clamp(2rem, 5vw, 4rem); line-height:1.05; max-width:850px; margin:9% 0 2%; }
h2 { color:var(--teal); font-size:clamp(1.7rem, 3vw, 2.7rem); margin:0 0 4%; }
.dark-slide h2 { color:#fff; }
p { font-size:clamp(.8rem, 1.35vw, 1.1rem); line-height:1.45; }
.stage,.kicker { color:var(--gold); font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
.subtitle { color:var(--ice); max-width:760px; font-size:clamp(1rem, 1.7vw, 1.35rem); }
.byline { color:#6f958f; font-style:italic; position:absolute; bottom:5%; }
.badge,.heading-badge,.question-mark { display:grid; place-items:center; background:var(--gold); color:#fff; border-radius:50%; font-weight:800; }
.badge { width:70px; height:70px; position:absolute; right:7%; top:9%; font-size:2rem; }
.heading-badge { width:42px; height:42px; display:inline-grid; font-family:Arial; font-size:1.4rem; vertical-align:middle; }
.two-column { display:grid; grid-template-columns:1.05fr 1fr; gap:8%; align-items:center; }
.lead { font-size:clamp(1rem, 1.55vw, 1.25rem); }
.icon-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; text-align:center; color:var(--teal); }
.icon-grid div span,.steps article>span,.stats-grid article>span { display:block; font-size:2rem; margin-bottom:8px; }
.icon-grid strong { display:block; }
.stat-band,.cards,.comparison,.steps,.stats-grid { display:grid; gap:18px; }
.stat-band { grid-template-columns:1fr 1fr 2fr; align-items:center; background:var(--cream); padding:22px 28px; position:absolute; left:6%; right:6%; bottom:7%; }
.stat strong { display:block; color:var(--gold); font:700 clamp(2rem,4vw,3rem) Georgia; }
.stat span { color:var(--soft); }.teal-stat strong { color:var(--teal); }
.cards { grid-template-columns:1fr 1fr; margin:5% 0; }.card { background:var(--cream); padding:24px; min-height:145px; }.card h3,.steps h3,.comparison h3 { margin:0 0 10px; color:var(--teal); }.card>strong { color:var(--gold); font:700 2.4rem Georgia; }.card .clay { color:var(--clay); }
.dark-band { background:var(--teal); color:#fff; padding:22px; }.dark-band h3 { color:var(--gold); }.economic-band { display:grid; grid-template-columns:1fr 1fr; gap:25px; }.economic-band strong { color:var(--gold); font:700 clamp(1.8rem,3vw,2.7rem) Georgia; }
.steps { grid-template-columns:repeat(3,1fr); text-align:center; margin:8% 0 5%; }.steps article>span,.stats-grid article>span { background:var(--gold); width:55px; height:55px; border-radius:50%; display:grid; place-items:center; margin:0 auto 15px; }.comparison { grid-template-columns:1fr 1fr; }.comparison article { padding:22px; background:var(--cream); }.comparison .dark-band h3 { color:var(--gold); }
.stats-grid { grid-template-columns:repeat(3,1fr); margin:8% 0; }.stats-grid article>strong { color:var(--gold); font:700 clamp(1.4rem,2.5vw,2.1rem) Georgia; display:block; }.stats-grid p { color:var(--ice); }.dark-slide hr { border:0; border-top:1px solid #2a5a61; }.closing { color:#fff; font-style:italic; font-size:clamp(1rem,1.8vw,1.35rem); }
.question-mark { width:52px; height:52px; float:left; margin-right:20px; font:700 2rem Georgia; }.questions { clear:both; padding:2% 0 0 3.5%; }.questions li { padding:1.2% 0 1.2% 1%; font-size:clamp(.95rem,1.55vw,1.25rem); line-height:1.35; }.questions li::marker { color:var(--gold); font:bold 1.5rem Georgia; }
.source-note { color:var(--ice); font-style:italic; }.source-list { columns:2; column-gap:35px; }.source-list p { color:var(--ice); font-size:clamp(.65rem,1vw,.85rem); break-inside:avoid; margin:0 0 13px; }.source-list b { color:var(--gold); }
.page-number { position:absolute; right:5%; bottom:3%; color:var(--soft); font-size:.75rem; }.dark-slide .page-number { color:#9bb7b3; }
.controls { position:fixed; bottom:20px; display:flex; gap:18px; align-items:center; background:#fff; padding:8px 14px; border-radius:30px; box-shadow:0 4px 18px #0003; }.controls button { border:0; background:var(--teal); color:#fff; border-radius:50%; width:34px; height:34px; font-size:1.7rem; line-height:20px; cursor:pointer; }.controls button:hover { background:var(--gold); }
@media (max-width:650px) { body { padding:0 0 70px; }.deck { width:100%; aspect-ratio:auto; min-height:100vh; box-shadow:none; }.slide { position:relative; min-height:100vh; padding:12% 7% 18%; }.title-slide { padding-top:22%; } h1 { margin-top:20%; }.badge { width:52px; height:52px; font-size:1.4rem; }.two-column,.cards,.comparison,.economic-band { grid-template-columns:1fr; }.stat-band { position:relative; left:auto; right:auto; bottom:auto; margin-top:8%; grid-template-columns:1fr 1fr; }.stat-band p { grid-column:1 / -1; }.steps,.stats-grid { grid-template-columns:1fr; margin:6% 0; }.source-list { columns:1; }.page-number { display:none; } }
